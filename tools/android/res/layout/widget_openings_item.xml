<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_item_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="9dp"
    android:paddingEnd="12dp"
    android:paddingBottom="9dp">

    <!-- Wie .favtile: ein rosa Streifen links fuer den Favoritenordner. -->
    <ImageView
        android:id="@+id/item_fav_bar"
        android:layout_width="3dp"
        android:layout_height="18dp"
        android:layout_marginEnd="7dp"
        android:src="@drawable/widget_fav_bar"
        android:visibility="gone" />

    <TextView
        android:id="@+id/item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/item_due"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:singleLine="true"
        android:textColor="@color/widget_due"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/item_new"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:singleLine="true"
        android:textColor="@color/widget_new"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/item_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:singleLine="true"
        android:text="erledigt"
        android:textColor="@color/widget_muted"
        android:textSize="13sp" />
</LinearLayout>
