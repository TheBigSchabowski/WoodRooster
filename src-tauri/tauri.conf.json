{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Schachtrainer",
  "version": "0.1.0",
  "identifier": "de.leidenschaftlicheslernen.schachtrainer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Schachtrainer",
        "width": 1040,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/openings.pack", "resources/openings.json"],
    "category": "Education",
    "shortDescription": "Schachpuzzle mit Spaced Repetition"
  }
}
