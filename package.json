{
  "name": "schachtrainer",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build-pack": "node --max-old-space-size=8192 tools/build-pack.mjs",
    "test": "tsc --noEmit && node tools/test-keys.mjs && node tools/test-solve.mjs && cargo test --manifest-path src-tauri/Cargo.toml --lib",
